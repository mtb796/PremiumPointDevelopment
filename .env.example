# Premium Point Development App — environment variables
# Copy to `.env` and fill in. Never commit `.env`. All keys are server-side only
# (consumed by functions under api/); none are exposed to the browser.

# --- Model access (api/model) ---
# The Anthropic API key. Used ONLY by the serverless /model function.
ANTHROPIC_API_KEY=
# Model name is a setting; claude-sonnet-5-5 is a sensible default.
MODEL_NAME=claude-sonnet-5-5

# --- Geocoding (api/geocode) ---
# U.S. Census geocoder one-line address endpoint (proxied server-side to avoid CORS).
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# --- Flood zones (api/gis) ---
# FEMA National Flood Hazard Layer ArcGIS REST service.
# Confirm the flood-hazard-zones layer index when wiring it; layer numbers can change.
FEMA_NFHL_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer

# --- Map tiles ---
# A tile provider whose terms permit this use. Do NOT hotlink the public OSM tile server
# for a deployed app. Set the style URL / key for your chosen provider.
MAP_TILE_STYLE_URL=
MAP_TILE_API_KEY=
